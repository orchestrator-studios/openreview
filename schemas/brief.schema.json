{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "brief.schema.json",
  "title": "Deep-research brief",
  "description": "The definition of one deep-research study: question, sub-questions, scope. The 'research' mode's analog of protocol.json.",
  "type": "object",
  "required": ["slug", "mode", "title", "question", "sub_questions"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "mode": { "const": "research" },
    "example": { "type": "boolean", "description": "True for a bundled demonstration study." },
    "title": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 1 },
    "sub_questions": {
      "type": "array",
      "minItems": 1,
      "description": "The decomposition of the question. Findings are tracked against these; the gate requires each to be answered.",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recency": { "type": "string", "description": "e.g. 'prefer sources < 5 years old'" },
        "source_types": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "searches": {
      "type": "array",
      "description": "Executed searches; append-only log. Database may be a web engine, PubMed, etc.",
      "items": {
        "type": "object",
        "required": ["database", "query", "date", "count"],
        "additionalProperties": false,
        "properties": {
          "database": { "type": "string" },
          "query": { "type": "string", "minLength": 1 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "count": { "type": "integer", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    }
  }
}
